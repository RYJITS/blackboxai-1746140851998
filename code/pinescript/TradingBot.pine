//@version=5
strategy("Multi-Confirmation Trading Bot", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// === Inputs ===
MinConfirmations = input.int(4, "Min Confirmations", minval=1, maxval=8)
atrLength = input.int(14, "ATR Length")
atrMultiplier = input.float(1.0, "ATR Multiplier")
debugMode = input.bool(true, "Debug Mode")

// === Indicators ===
// ATR for stops
atr = ta.atr(atrLength)

// Signal 1: Break of Structure (BOS) - simplified placeholder
bos = ta.crossover(ta.highest(high, 5), ta.highest(high, 10)) ? 1 : ta.crossunder(ta.lowest(low, 5), ta.lowest(low, 10)) ? -1 : 0

// Signal 2: Trendline Break (SMA20/SMA50 crossover)
sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
trendBreak = ta.crossover(sma20, sma50) ? 1 : ta.crossunder(sma20, sma50) ? -1 : 0

// Signal 3: Double Top / Double Bottom (simplified)
doubleTop = (high[1] > high[2] and high[1] > high and high[1] > high[3]) ? -1 : 0
doubleBottom = (low[1] < low[2] and low[1] < low and low[1] < low[3]) ? 1 : 0
doubleTopBottom = doubleTop + doubleBottom

// Signal 4: MACD
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdSignal = macdLine > signalLine ? 1 : macdLine < signalLine ? -1 : 0

// Signal 5: RSI
rsi = ta.rsi(close, 14)
rsiSignal = rsi > 70 ? -1 : rsi < 30 ? 1 : 0

// Signal 6: Fibonacci retracement (simplified)
// Using recent swing high/low
var float fibHigh = na
var float fibLow = na
if ta.change(time("D"))
    fibHigh := ta.highest(high, 20)
    fibLow := ta.lowest(low, 20)
fibLevel = fibLow + (fibHigh - fibLow) * 0.618
fibSignal = close > fibLevel ? 1 : close < fibLevel ? -1 : 0

// Signal 7: Support / Resistance (simplified)
// Using pivot points
pivotHigh = ta.pivothigh(high, 5, 5)
pivotLow = ta.pivotlow(low, 5, 5)
supResSignal = 0
if not na(pivotHigh) and close < pivotHigh
    supResSignal := -1
else if not na(pivotLow) and close > pivotLow
    supResSignal := 1

// Signal 8: Volume (simplified)
// Volume higher than average volume
avgVol = ta.sma(volume, 20)
volSignal = volume > avgVol ? 1 : 0

// === Count confirmations ===
signals = array.new_int(8)
array.set(signals, 0, bos)
array.set(signals, 1, trendBreak)
array.set(signals, 2, doubleTopBottom)
array.set(signals, 3, macdSignal)
array.set(signals, 4, rsiSignal)
array.set(signals, 5, fibSignal)
array.set(signals, 6, supResSignal)
array.set(signals, 7, volSignal)

bullCount = 0
bearCount = 0
for i = 0 to 7
    val = array.get(signals, i)
    if val == 1
        bullCount += 1
    else if val == -1
        bearCount += 1

if debugMode
    label.new(bar_index, high, "Signals: " + str.tostring(array.get(signals, 0)) + " " + str.tostring(array.get(signals, 1)) + " " + str.tostring(array.get(signals, 2)) + " " + str.tostring(array.get(signals, 3)) + " " + str.tostring(array.get(signals, 4)) + " " + str.tostring(array.get(signals, 5)) + " " + str.tostring(array.get(signals, 6)) + " " + str.tostring(array.get(signals, 7)), yloc=yloc.abovebar, color=color.gray, style=label.style_label_down, size=size.tiny)

// === Entry conditions ===
longCondition = bullCount >= MinConfirmations and strategy.position_size <= 0
shortCondition = bearCount >= MinConfirmations and strategy.position_size >= 0

// === Risk management ===
atrStop = atr * atrMultiplier

if (longCondition)
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=strategy.position_avg_price - atrStop, trail_points=atrStop, trail_offset=atrStop * 0.5)

if (shortCondition)
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=strategy.position_avg_price + atrStop, trail_points=atrStop, trail_offset=atrStop * 0.5)

// === Close on reversal ===
if strategy.position_size > 0 and bearCount >= MinConfirmations
    strategy.close("Long")
if strategy.position_size < 0 and bullCount >= MinConfirmations
    strategy.close("Short")
